AMAZON_EMAIL=
AMAZON_PASSWORD=
ASIN=

# Optional Codex processing overrides
CODEX_MODEL=
CODEX_BATCH_SIZE=8
CODEX_CONCURRENCY=1
CODEX_TIMEOUT_MS=300000
ALLOW_PARTIAL=false

# Page-analysis phase of the screenshot pipeline
# (capture-book-text.ts with OCR=1, and analyze-book-text.ts)
# Backend: codex (default) or claude (the Claude Code CLI)
ANALYZER=codex
# true re-analyzes pages that already have a page-####.json result
REPROCESS=false
# Optional: only these pages may be (re)analyzed, e.g. 1-20,45
PAGES=
# Codex backend: model (CODEX_MODEL above, e.g. gpt-5.6-sol; CLI default when
# empty) and reasoning effort: minimal | low | medium | high | xhigh
CODEX_REASONING_EFFORT=xhigh
# Claude Code CLI backend (used when ANALYZER=claude)
CLAUDE_CLI_BIN=claude
# Model alias or full name, e.g. opus, sonnet, claude-opus-5; CLI default when empty
CLAUDE_CLI_MODEL=
# low | medium | high | xhigh | max (levels above high depend on the model)
CLAUDE_CLI_EFFORT=high
CLAUDE_CLI_TIMEOUT_MS=300000

# Optional, only required when TTS_ENGINE=openai
OPENAI_API_KEY=
